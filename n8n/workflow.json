        }
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Gatilho Semanal",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [80, 500]
    },
    {
      "parameters": {
        "command": "cd {{ $env.PROJECT_DIR || '.' }} && python src/engine.py --paises BRA,USA,FIN,CHN,DEU,JPN,ZAF,IND,ARG,KOR",
        "cwd": "={{ $env.PROJECT_DIR || '.' }}"
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Executar Script Python",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [340, 400]
